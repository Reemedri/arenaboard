# ArenaBoard environment variables
#
# For local dev: copy to .env and adjust if needed (defaults work).
# On Railway: set these in the dashboard under Variables.

# Port the server listens on. Railway sets this automatically; locally defaults to 3001.
PORT=3001

# MOCK_MODE=true  → generates a fake game when ESPN has no live games (recommended for dev)
# MOCK_MODE=false → only broadcasts real live ESPN games, nothing otherwise
MOCK_MODE=true
